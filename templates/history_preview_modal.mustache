{{!
    @template filter_dixeo_imageeditor/history_preview_modal

    Full-size preview of one version history entry with carousel navigation.

    Example context (json):
    {
        "previewurl": "https://example.com/moodle/fixture-preview.png",
        "timecreated": 1710000000,
        "versionid": 42,
        "has_prev": true,
        "has_next": true,
        "is_current": false,
        "manual_editing": false
    }
}}
<div class="dixeo-imageeditor-history-preview" data-region="history-preview-root">
    <div class="dixeo-imageeditor-history-preview__stage">
        <button
            type="button"
            class="dixeo-imageeditor-history-preview__nav dixeo-imageeditor-history-preview__nav--prev"
            data-action="history-prev"
            aria-label="{{#str}} history_preview_prev, filter_dixeo_imageeditor {{/str}}"
            {{^has_prev}}disabled{{/has_prev}}
        >
            <i class="icon fa fa-chevron-left fa-fw" aria-hidden="true"></i>
        </button>
        <div class="dixeo-imageeditor-history-preview__image-wrap">
            <img
                src="{{previewurl}}"
                alt=""
                class="dixeo-imageeditor-history-preview__image"
                data-region="history-preview-image"
            >
        </div>
        <button
            type="button"
            class="dixeo-imageeditor-history-preview__nav dixeo-imageeditor-history-preview__nav--next"
            data-action="history-next"
            aria-label="{{#str}} history_preview_next, filter_dixeo_imageeditor {{/str}}"
            {{^has_next}}disabled{{/has_next}}
        >
            <i class="icon fa fa-chevron-right fa-fw" aria-hidden="true"></i>
        </button>
    </div>
    <p class="dixeo-imageeditor-history-preview__meta" data-region="history-preview-meta">{{#userdate}} {{timecreated}}, {{#str}} strftimedatetimeshort, core_langconfig {{/str}} {{/userdate}}</p>
    <div class="dixeo-imageeditor-history-preview__actions">
        {{^manual_editing}}
        <button type="button" class="btn btn-primary" data-action="set-current" data-versionid="{{versionid}}">
            {{#str}} history_set_current, filter_dixeo_imageeditor {{/str}}
        </button>
        {{^is_current}}
        <button type="button" class="btn btn-outline-danger" data-action="delete-history" data-versionid="{{versionid}}">
            {{#str}} history_delete, filter_dixeo_imageeditor {{/str}}
        </button>
        {{/is_current}}
        {{/manual_editing}}
    </div>
</div>
